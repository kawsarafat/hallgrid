# Node keys, one per node: nodeId:key pairs separated by commas.
# Without this the server rejects node data.
NODE_KEYS=f1-north:replace-me,f1-south:replace-me,common:replace-me

# Needed to read QR reports and send test alerts from the dashboard.
ADMIN_KEY=replace-me

# Optional: the hall's Telegram bot and chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_TUTOR=
TELEGRAM_CHAT_ELECTRICIAN=
TELEGRAM_CHAT_PROVOST=
TELEGRAM_CHAT_STUDENTS=
